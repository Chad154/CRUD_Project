<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD JasperReport//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport name="account_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="CUSTOMER_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["N/A"]]></defaultValueExpression>
    </parameter>

    <field name="id"                    class="java.lang.Long"/>
    <field name="description"           class="java.lang.String"/>
    <field name="type"                  class="java.lang.Object"/>
    <field name="creditLine"            class="java.lang.Double"/>
    <field name="balance"               class="java.lang.Double"/>
    <field name="beginBalance"          class="java.lang.Double"/>
    <field name="beginBalanceTimestamp" class="java.util.Date"/>

    <variable name="TOTAL_BALANCE" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{balance}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>

    <background>
        <band/>
    </background>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="782" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[ACCOUNT REPORT]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="400" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Customer ID: " + $P{CUSTOMER_ID}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="400" y="35" width="382" height="20"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band/>
    </pageHeader>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="100" height="25" backcolor="#42A5F5" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ID / Account]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="0" width="190" height="25" backcolor="#42A5F5" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="290" y="0" width="90" height="25" backcolor="#42A5F5" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Type]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="0" width="100" height="25" backcolor="#42A5F5" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Credit Line]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="0" width="100" height="25" backcolor="#42A5F5" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Begin Balance]]></text>
            </staticText>
            <staticText>
                <reportElement x="580" y="0" width="100" height="25" backcolor="#42A5F5" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Balance (EUR)]]></text>
            </staticText>
            <staticText>
                <reportElement x="680" y="0" width="102" height="25" backcolor="#42A5F5" mode="Opaque" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Opening Date]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.Long"><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="100" y="0" width="190" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="290" y="0" width="90" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{type} != null ? $F{type}.toString() : ""]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="380" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.Double"><![CDATA[$F{creditLine} != null ? $F{creditLine} : 0.0]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="480" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.Double"><![CDATA[$F{beginBalance} != null ? $F{beginBalance} : 0.0]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="580" y="0" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.Double"><![CDATA[$F{balance} != null ? $F{balance} : 0.0]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="680" y="0" width="102" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression class="java.util.Date"><![CDATA[$F{beginBalanceTimestamp}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <columnFooter>
        <band/>
    </columnFooter>

    <pageFooter>
        <band height="20">
            <staticText>
                <reportElement x="0" y="3" width="400" height="15" forecolor="#757575"/>
                <textElement textAlignment="Left">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[© Conectica]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="3" width="382" height="15" forecolor="#757575"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="35">
            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#1565C0"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="580" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL BALANCE:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="580" y="5" width="100" height="25" forecolor="#1565C0"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.Double"><![CDATA[$V{TOTAL_BALANCE}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
